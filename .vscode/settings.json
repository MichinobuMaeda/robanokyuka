{
  "cSpell.words": [
    "allprojects",
    "aokvm",
    "appdistribution",
    "appinvite",
    "canvaskit",
    "carryforward",
    "Eventarc",
    "firebaseapp",
    "firebaserc",
    "firebasestorage",
    "firestore",
    "fpdart",
    "Gengo",
    "gengos",
    "genhtml",
    "googleusercontent",
    "jvmargs",
    "Maeda",
    "Metaspace",
    "Michinobu",
    "mmdd",
    "Nengo",
    "notanemail",
    "notif",
    "Noto",
    "nvmrc",
    "passwordless",
    "predeploy",
    "prefs",
    "pubspec",
    "reauthenticating",
    "Reauthentication",
    "riverpod",
    "robanokyuka",
    "subcollection",
    "subosito",
    "temurin",
    "testutils",
    "uids",
    "Unrecognised"
  ],
  "cSpell.ignorePaths": [
    ".dart_tool/*",
    ".gitignore",
    ".idea/*",
    ".metadata",
    ".vscode/*",
    "android/**/*.json",
    "build/*",
    "**/package-lock.json",
    "pubspec.lock"
  ],
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "eslint.format.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": [
    {
      "directory": "functions",
      "changeProcessCWD": true
    }
  ],
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "git.addAICoAuthor": "off"
}
